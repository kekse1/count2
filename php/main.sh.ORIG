#

# if not set, using the basename($0, '.php');
file="$1"

#
real="$(realpath "$0")"
realDir="$(dirname "$real")"
dir="$(dirname "$0")"
base="$(basename "$0")"
realBase="$(basename "$real")"
php="`which php 2>/dev/null`"


if [[ -z "$php" ]]; then
	echo " >> No \`php\` interpreter found!" >&2
	exit 1
elif [[ -z "$file" ]]; then
	if [[ ! -L "$0" ]]; then
		echo " >> Either call the symbolic link shell script," >&2
		echo "    or argue with your .php app name (directory)." >&2
		exit 2
	fi

	target="$(readlink "$0")"

	if [[ -L "$target" ]]; then
		eval "$target"
		exit $?
	else
		file="$(basename "$base" .sh).php"
	fi
elif [[ -d "$1" ]]; then
	file="${dir}/${1}/main.php"
else
	echo " >> Invalid argument (not found)!" >&2
	exit 3
fi

if [[ ! -r "$file" ]]; then
	echo " >> Can't read file '$file'!" >&2
	exit 4
fi

#
eval "${php} ${dir}/${file} \"$@\""

